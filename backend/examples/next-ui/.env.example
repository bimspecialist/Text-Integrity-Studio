# Copy to .env.local and generate secrets privately. Never commit .env.local.
TIS_PUBLIC_ORIGIN=http://localhost:3000
TIS_API_KEY=replace-with-the-private-40-character-FastAPI-server-key
TIS_SESSION_JWT_SECRET=replace-with-32-plus-random-characters-from-real-session-issuer
# Issuer must mint HS256 JWTs with iss=tis-auth-service, aud=tis-detector, sub=user-id.
# Development ONLY: 32+ char separate local session setup key (never deploy to production).
TIS_LOCAL_DEV_SETUP_KEY=replace-with-another-independent-32-character-local-only-secret
# Cookie name: tis_session (HttpOnly, Secure on HTTPS; development localhost uses HTTP).

# Required: generate 32+ random characters on the server. NEVER commit real keys.
TIS_API_KEYS=replace-with-at-least-32-random-secret-characters
TIS_CALIBRATION_DIR=/opt/tis/models
# OFF until real independent holdout, provenance review and operator approval pass.
TIS_ENABLE_APPROVED_SCORES=false
TIS_REQUESTS_PER_MINUTE=30
TIS_CONCURRENCY=2
# Optional trusted local checkpoints; not downloaded by the server:
# TIS_LOCAL_CAUSAL_LM_DIR=/opt/tis/checkpoints/causal-lm
# TIS_LOCAL_EMBEDDINGS_DIR=/opt/tis/checkpoints/multilingual-embeddings
# TIS_LOCAL_CLASSIFIER_DIR=/opt/tis/checkpoints/binary-detector
# TIS_LOCAL_AI_CLASS_INDEX=1

# Optional: use locally provisioned model checkpoints for English/Arabic.
# Run: python -m hybrid_detector.provision_models --language en --destination /opt/tis/models/en
# Run: python -m hybrid_detector.provision_models --language ar --destination /opt/tis/models/ar
# Each checkpoint is around 400-500 MB and requires torch + transformers.
TIS_LOCAL_EN_CLASSIFIER_DIR=/opt/tis/models/en
TIS_LOCAL_EN_AI_CLASS_INDEX=1
TIS_LOCAL_AR_CLASSIFIER_DIR=/opt/tis/models/ar
TIS_LOCAL_AR_AI_CLASS_INDEX=1
# Do NOT enable verified percentages from the weak-label public baseline.
TIS_ENABLE_APPROVED_SCORES=false
